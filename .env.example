# Copy to .env and fill in, or run ./scripts/init-env.sh, which copies this file and fills in the
# token, the allowed hosts and the public URL. Tags:
#   REQUIRED  — uncommented; the engine refuses to start without it, naming the key. Blank values
#               are filled in by init-env.sh.
#   OPTIONAL  — commented out at its default; uncomment to set.
#   COMPOSE   — read by docker-compose.yml, not by the engine.
# Compose passes this file to the engine container. Engine keys use the ENGINE_ prefix.

# ── Access ───────────────────────────────────────────────────────────────────────
# REQUIRED — the static bearer token every MCP call must present, at least 32 characters.
# init-env.sh writes a generated 48-character value.
ENGINE_BEARER_TOKEN=
# REQUIRED — the Host header values the engine answers, comma separated, none empty. init-env.sh
# writes engine:<ENGINE_PORT>, the address inside the Compose network, plus 127.0.0.1 and localhost
# at ENGINE_HOST_PORT, for MCP Inspector on this machine.
ENGINE_ALLOWED_HOSTS=
# REQUIRED — the base URL callers reach the engine at: http or https, no /mcp, no trailing slash.
# init-env.sh writes http://127.0.0.1:<ENGINE_HOST_PORT>.
ENGINE_PUBLIC_URL=

# ── Ports ────────────────────────────────────────────────────────────────────────
# REQUIRED — the port the engine listens on inside its container.
ENGINE_PORT=8020
# COMPOSE — the port published on this machine's loopback interface, where MCP Inspector connects;
# it must be free on the host.
ENGINE_HOST_PORT=8100

# ── Storage ──────────────────────────────────────────────────────────────────────
# OPTIONAL — folder holding the stored market data (market.json); compose mounts the engine-data
# volume at /data, the default.
# ENGINE_DATA_DIR=/data
