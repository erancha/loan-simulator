# Copy to .env and fill in, or run ./scripts/init-env.sh, which copies this file and fills in the
# generated values (tokens, passwords, addresses). Tags:
#   REQUIRED  — uncommented; the service refuses to start without it, naming the key. Blank values
#               are filled in by init-env.sh, or by you where the comment says so.
#   OPTIONAL  — commented out at its default; uncomment to set.
#   COMPOSE   — read by docker-compose.yml, not by a service.
# Compose hands each container only the keys it reads, listed per service in docker-compose.yml.
# Engine keys use the ENGINE_ prefix, except ENGINE_URL, the agent's address for the engine.
# Run host commands (pytest, uvicorn) from the repo root: the agent reads .env from the working
# directory.

# ── Engine access ────────────────────────────────────────────────────────────────
# REQUIRED — the static bearer token every MCP call must present, at least 32 characters. The
# engine checks it and the agent presents it, so it is defined only here. init-env.sh writes a
# generated 48-character value.
ENGINE_BEARER_TOKEN=
# REQUIRED — the Host header values the engine answers, comma separated, none empty. init-env.sh
# writes engine:<ENGINE_PORT>, the address inside the Compose network, plus localhost and 127.0.0.1
# at ENGINE_HOST_PORT, for MCP Inspector on this machine.
ENGINE_ALLOWED_HOSTS=
# REQUIRED — the base URL callers reach the engine at: http or https, no /mcp, no trailing slash.
# init-env.sh writes http://localhost:<ENGINE_HOST_PORT>.
ENGINE_PUBLIC_URL=
# REQUIRED — the engine's MCP endpoint as the agent reaches it, path included. Compose replaces it
# with the in-network address (http://engine:<ENGINE_PORT>/mcp); the value here serves an agent
# started on the host. init-env.sh writes ENGINE_PUBLIC_URL followed by /mcp.
ENGINE_URL=

# ── Ports ────────────────────────────────────────────────────────────────────────
# REQUIRED — the port the engine listens on inside its container.
ENGINE_PORT=8020
# COMPOSE — the port published on this machine's loopback interface, where MCP Inspector connects;
# it must be free on the host.
ENGINE_HOST_PORT=8100
# COMPOSE — the port the agent listens on inside its container; compose passes it to the agent
# image's start command, not to the agent's settings.
AGENT_PORT=8000
# COMPOSE — the loopback port the agent's API is published on; the page and sign-in use it. It
# must be free on the host.
AGENT_HOST_PORT=8101
# COMPOSE — the loopback port Postgres is published on, for an agent started on the host
# (DATABASE_URL names it) or a psql on this machine. It must be free on the host.
DB_HOST_PORT=8102

# ── Database ─────────────────────────────────────────────────────────────────────
# COMPOSE — the port Postgres listens on inside its container.
DB_PORT=5432
# COMPOSE — the Postgres user and database the agent's tables live in; read by docker-compose.yml,
# init-env.sh and sql-helper.sh, and set when the database volume is first created.
POSTGRES_USER=loan
POSTGRES_DB=loan
# COMPOSE — the password of POSTGRES_USER, set when the database volume is first created; changing
# it later needs --volumes on the stop (docker-helper.sh) or ALTER USER. init-env.sh writes a
# generated value.
POSTGRES_PASSWORD=
# REQUIRED — the agent's database in SQLAlchemy form, as the host reaches it (DB_HOST_PORT).
# Compose replaces it with the in-network address (db:<DB_PORT>). init-env.sh writes it with the
# generated POSTGRES_PASSWORD.
DATABASE_URL=

# ── Language model ───────────────────────────────────────────────────────────────
# REQUIRED — provider:model of the chat model, for the provider anthropic or openai. Fill in by
# hand, e.g. anthropic:claude-sonnet-5-5.
LLM_MODEL=
# REQUIRED — the provider's API key for LLM_MODEL. Fill in by hand.
LLM_API_KEY=

# ── Sign-in ──────────────────────────────────────────────────────────────────────
# REQUIRED — the OAuth client ID of the page's Sign in with Google button, which every ID token
# must name as its audience. Fill in by hand (docs/sign-in.md).
GOOGLE_CLIENT_ID=
# OPTIONAL — the issuer every ID token must name.
# AUTH_ISSUER=https://accounts.google.com
# OPTIONAL — where the issuer publishes the keys that sign its tokens.
# AUTH_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# OPTIONAL, tests only — a PEM public key file that verifies tokens instead of the published keys,
# so a test signs its own tokens and never reaches Google.
# AUTH_PUBLIC_KEY_FILE=

# ── Turn cap ─────────────────────────────────────────────────────────────────────
# OPTIONAL — messages one person may send, across all their checks, in any rolling window; each
# message costs model calls.
# AGENT_TURN_LIMIT=50
# OPTIONAL — the length of that rolling window, in hours.
# AGENT_TURN_WINDOW_HOURS=24

# ── Logging ──────────────────────────────────────────────────────────────────────
# OPTIONAL — the agent's log level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
# AGENT_LOG_LEVEL=WARNING

# ── Storage ──────────────────────────────────────────────────────────────────────
# OPTIONAL — folder holding the engine's stored market data (market.json); compose mounts the
# engine-data volume at /data, the default.
# ENGINE_DATA_DIR=/data
